# Copy to .env.rds.local. Never commit the populated local file.
# URL-encode special characters in the database username and password.
# Keep sslmode=require for encrypted RDS connections.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@RDS_ENDPOINT:5432/dementia_coach?sslmode=require

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Use the same comma-separated value for both admin variables.
ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_EMAILS=

LLM_PROVIDER=harvard
HARVARD_OPENAI_KEY=
HARVARD_OPENAI_BASE_URL=https://go.apis.huit.harvard.edu/ais-openai-direct/v2/
HARVARD_MODEL=gpt-5.5

# Optional fallback provider and RAG embedding provider.
GEMINI_API_KEY=
