{
  "family": "ecllm_app",
  "taskRoleArn": "arn:aws:iam::895735450791:role/Aria_API_ECS_Task",
  "executionRoleArn": "arn:aws:iam::895735450791:role/Aria_API_ECS_Task",
  "networkMode": "bridge",
  "requiresCompatibilities": [
    "EC2"
  ],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "ecllm_app",
      "image": "895735450791.dkr.ecr.us-west-2.amazonaws.com/ecllm_app:latest",
      "essential": true,
      "cpu": 250,
      "memoryReservation": 256,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 0,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        }
      ],
      "dependsOn": [
        {
          "containerName": "ecllm_backend",
          "condition": "HEALTHY"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -q --spider http://localhost:3000/ || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "ecllm_app",
          "awslogs-region": "us-west-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    },
    {
      "name": "ecllm_backend",
      "image": "895735450791.dkr.ecr.us-west-2.amazonaws.com/ecllm_backend:latest",
      "essential": true,
      "cpu": 250,
      "memoryReservation": 256,
      "portMappings": [
        {
          "containerPort": 3001,
          "hostPort": 0,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3001"
        },
        {
          "name": "HARVARD_OPENAI_BASE_URL",
          "value": "https://go.apis.huit.harvard.edu/ais-openai-direct/v2/"
        }
      ],
      "secrets": [
        {
          "name": "HARVARD_OPENAI_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-west-2:895735450791:secret:ecllmapp-fRw0Wn:HARVARD_OPENAI_KEY::"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -q --spider http://localhost:3001/health || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "ecllm_backend",
          "awslogs-region": "us-west-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "volumes": [],
  "placementConstraints": [],
  "tags": [
    {
      "key": "Application",
      "value": "ecllm"
    }
  ]
}
