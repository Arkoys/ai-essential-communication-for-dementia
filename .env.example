# ===========================================
# Docker Compose Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# -------------------------------------------
# Harvard HUIT OpenAI Direct v2 (Backend)
# -------------------------------------------
# API key for Harvard's OpenAI-compatible gateway
# Keep this server-side only - never expose to frontend!
HARVARD_OPENAI_KEY=your_harvard_api_key_here

# Base URL for Harvard API (usually default is fine)
HARVARD_OPENAI_BASE_URL=https://go.apis.huit.harvard.edu/ais-openai-direct/v2/

# -------------------------------------------
# Firebase Configuration
# -------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# -------------------------------------------
# LLM Providers (Frontend)
# -------------------------------------------
# Default LLM provider: openai, gemini, minimax, or harvard
VITE_LLM_PROVIDER=openai

# OpenAI
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=

# Google Gemini
VITE_GEMINI_API_KEY=

# MiniMax
VITE_MINIMAX_API_KEY=
VITE_MINIMAX_MODEL=
VITE_MINIMAX_API_BASE_URL=
