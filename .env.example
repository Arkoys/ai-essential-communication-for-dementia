# Environment Variables for AI Essential Communication for Dementia

# ============================================
# LLM Provider Configuration
# ============================================
# Options: 'gemini' (default), 'minimax', 'harvard'
LLM_PROVIDER=gemini

# ============================================
# Google Gemini Configuration (Default)
# ============================================
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ============================================
# MiniMax Configuration (Alternative)
# ============================================
# Get your API key from: https://platform.minimaxi.chat
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_API_BASE_URL=https://api.minimaxi.chat
MINIMAX_API_PATH=/v1/chat/completions

# ============================================
# Harvard HUIT OpenAI Direct v2 Configuration (Alternative)
# ============================================
# Harvard API credentials - Contact HUIT for access
# Uses api-key header authentication (NOT Bearer token)
HARVARD_OPENAI_KEY=
HARVARD_OPENAI_BASE_URL=https://go.apis.huit.harvard.edu/ais-openai-direct/v2/
HARVARD_MODEL=gpt-4o-mini

# ============================================
# Firebase Configuration (Optional)
# ============================================
# If using Firebase services
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=

# ============================================
# Development Settings
# ============================================
# Disable HMR for AI Studio environments
# DISABLE_HMR=true