# ===========================================
# Docker Compose Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# -------------------------------------------
# Harvard HUIT OpenAI Direct v2 (Backend)
# -------------------------------------------
# API key for Harvard's OpenAI-compatible gateway
# Keep this server-side only - never expose to frontend!
HARVARD_OPENAI_KEY=your_harvard_api_key_here

# Base URL for Harvard API (usually default is fine)
HARVARD_OPENAI_BASE_URL=https://go.apis.huit.harvard.edu/ais-openai-direct/v2/

# -------------------------------------------
# Firebase Configuration
# -------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)
VITE_FIREBASE_MEASUREMENT_ID=

# -------------------------------------------
# LLM Provider
# -------------------------------------------
# Default LLM provider: gemini, minimax, or harvard
LLM_PROVIDER=harvard

# Google Gemini
GEMINI_API_KEY=

# MiniMax
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_API_BASE_URL=https://api.minimaxi.chat
MINIMAX_API_PATH=/v1/chat/completions
