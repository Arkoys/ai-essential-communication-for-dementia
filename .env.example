# =============================================================================
# Dementia Clinical Coach — environment variables
# Copy this to .env.local for local dev. Docker compose reads these too.
# =============================================================================
#
# ⚠️  NEVER commit a populated .env.local. Anything below is a SECRET.
# ⚠️  Use NEXT_PUBLIC_* ONLY for values that are safe to ship to browsers
#     (e.g. admin email allowlist). API keys MUST stay server-side.
# =============================================================================

# ---------- Postgres ----------
POSTGRES_DB=dementia_coach
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@postgres:5432/dementia_coach

# ---------- Better Auth ----------
# Generate a strong secret: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# ---------- Admin gating ----------
# Comma-separated emails that can manage knowledge chunks (RAG corpus).
# Both server (lib/admin.ts) and client (lib/auth-client.ts) read this.
ADMIN_EMAILS=
# Mirror as NEXT_PUBLIC_* so the client bundle can decide whether to show
# the AdminPanel button without round-tripping. Safe to ship to browsers.
NEXT_PUBLIC_ADMIN_EMAILS=

# ---------- LLM (server-side ONLY — read inside /api routes) ----------
# These keys are NEVER exposed to the client. Set them here so the
# /api/chat, /api/harvard, /api/minimax, /api/gemini proxies can call the
# providers. Set at least one *_API_KEY below — the app needs an LLM to
# generate responses.
LLM_PROVIDER=harvard
GEMINI_API_KEY=
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_API_BASE_URL=https://api.minimaxi.chat
MINIMAX_API_PATH=/v1/chat/completions
HARVARD_OPENAI_KEY=
HARVARD_OPENAI_BASE_URL=https://go.apis.huit.harvard.edu/ais-openai-direct/v2/
HARVARD_MODEL=gpt-4o-mini

