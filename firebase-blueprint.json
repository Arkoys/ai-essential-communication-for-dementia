{
  "entities": {
    "Conversation": {
      "title": "Conversation",
      "description": "A chat session between a PCP and the assistant.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The ID of the user who owns this conversation."
        },
        "title": {
          "type": "string",
          "description": "A brief title for the conversation."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the conversation was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the conversation was last updated."
        }
      },
      "required": ["userId", "title", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A single message within a conversation.",
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "description": "The ID of the conversation this message belongs to."
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"],
          "description": "The sender of the message."
        },
        "content": {
          "type": "string",
          "description": "The text content of the message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the message was created."
        }
      },
      "required": ["conversationId", "role", "content", "createdAt"]
    },
    "KnowledgeChunk": {
      "title": "KnowledgeChunk",
      "description": "A chunk of text from a clinical resource with its embedding.",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "embedding": { "type": "array", "items": { "type": "number" } },
        "source": { "type": "string" }
      },
      "required": ["content", "embedding", "source"]
    },
    "RagConfig": {
      "title": "RagConfig",
      "description": "Configuration for the RAG pipeline.",
      "type": "object",
      "properties": {
        "topK": { "type": "number" },
        "similarityThreshold": { "type": "number" }
      },
      "required": ["topK", "similarityThreshold"]
    }
  },
  "firestore": {
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Stores all chat conversations."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Stores messages for a specific conversation."
    },
    "/knowledge_chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/KnowledgeChunk" },
      "description": "Stores text chunks and embeddings for RAG."
    },
    "/app_settings/rag_config": {
      "schema": { "$ref": "#/entities/RagConfig" },
      "description": "Stores global RAG configuration."
    }
  }
}
